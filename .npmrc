# eslint-plugin-astro's peerOptional range on eslint-plugin-jsx-a11y hasn't
# caught up to ESLint 9 yet, which makes a strict npm install fail with
# ERESOLVE. legacy-peer-deps matches how this project's dependencies were
# actually installed (and what's recorded in package-lock.json) — without
# this file, a fresh `npm install` (e.g. on Netlify) re-resolves peers
# strictly and hits the same conflict.
legacy-peer-deps=true
