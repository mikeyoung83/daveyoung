---
// ContactForm.astro
// Netlify Forms handles submission (no server/adapter needed) — the form
// just needs `data-netlify="true"`, a matching hidden `form-name` field,
// and a honeypot field Netlify's spam filter checks. Shared between the
// Contact page and FooterCta so every instance posts to the same named
// Netlify form regardless of which page it's embedded on.
//
// Every field uses the same stacked "label above field" pattern (plain
// <label> + separate .input/.textarea, not daisyUI's inline
// label-inside-input pattern) so label sizing is consistent, and each
// field gets an explicit visible border — daisyUI's default field border
// is a ~20%-opacity tint that's nearly invisible against this theme's pale
// cream base colors.
const fieldClass = 'input w-full border-2 border-base-content/25 bg-base-100 focus:border-primary';
---

<form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field">
  <input type="hidden" name="form-name" value="contact" />
  <p class="hidden">
    <label>
      Don't fill this out if you're human: <input name="bot-field" />
    </label>
  </p>

  <fieldset class="fieldset space-y-4">
    <div class="flex flex-col items-start gap-1">
      <label for="contact-name" class="label">Name</label>
      <input id="contact-name" type="text" name="name" required class={fieldClass} />
    </div>

    <div class="flex flex-col items-start gap-1">
      <label for="contact-email" class="label">Email</label>
      <input id="contact-email" type="email" name="email" required class={fieldClass} />
    </div>

    <div class="flex flex-col items-start gap-1">
      <label for="contact-phone" class="label">Phone</label>
      <input id="contact-phone" type="tel" name="phone" class={fieldClass} />
    </div>

    <div class="flex flex-col items-start gap-1">
      <label for="contact-message" class="label">Tell us about the job</label>
      <textarea
        id="contact-message"
        name="message"
        rows="5"
        required
        class={`textarea w-full border-2 border-base-content/25 bg-base-100 focus:border-primary`}
      ></textarea>
    </div>

    <button type="submit" class="btn btn-accent btn-lg mt-2">Send</button>
  </fieldset>
</form>
