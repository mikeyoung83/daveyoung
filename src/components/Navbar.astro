---
// Navbar.astro
// Brand + hamburger dropdown on mobile, centered link row on desktop,
// single CTA button. Marks the current page via aria-current rather than
// decorative styling — a quiet, functional signal instead of a visual tell.
// The outer <header> spans full width for its background/border and
// carries the horizontal padding; the inner .navbar is a plain
// mx-auto max-w-6xl with no padding of its own — matching the
// section > mx-auto max-w-6xl div pattern used on every page, so the
// logo/links line up exactly with the page content below.

interface NavItem {
  label: string;
  href: string;
}

interface CTA {
  label: string;
  href: string;
}

interface Props {
  siteName: string;
  navItems: NavItem[];
  cta?: CTA;
}

const { siteName, navItems, cta } = Astro.props;
const currentPath = Astro.url.pathname;
---

<header class="border-b border-base-200 bg-base-100 px-4 lg:px-8">
  <div class="navbar mx-auto max-w-6xl">
    <div class="navbar-start gap-1">
      <div class="dropdown lg:hidden">
        <div tabindex="0" role="button" aria-label="Open menu" class="btn btn-ghost btn-square">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </div>
        {/* eslint-disable-next-line astro/jsx-a11y/no-noninteractive-tabindex -- daisyUI's CSS-only dropdown needs this <ul> focusable so .dropdown:focus-within can show it without JS; not a true interactive-role violation. */}
        <ul tabindex="0" class="menu dropdown-content menu-sm z-1 mt-3 w-56 rounded-box bg-base-100 p-2 shadow">
          {navItems.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={currentPath === item.href ? 'page' : undefined}
                class={currentPath === item.href ? 'bg-transparent font-medium text-primary' : ''}
              >
                {item.label}
              </a>
            </li>
          ))}
          {cta && (
            <li class="mt-2">
              <a href={cta.href} class="btn btn-primary btn-sm">
                {cta.label}
              </a>
            </li>
          )}
        </ul>
      </div>

      <a href="/" class="font-heading text-lg font-semibold">
        {siteName}
      </a>
    </div>

    <nav class="navbar-center hidden lg:flex" aria-label="Primary">
      <ul class="menu menu-horizontal gap-1">
        {navItems.map((item) => {
          const isActive = currentPath === item.href;
          return (
            <li>
              <a
                href={item.href}
                aria-current={isActive ? 'page' : undefined}
                class={isActive ? 'bg-transparent font-medium text-primary' : ''}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="navbar-end">
      {cta && (
        <a href={cta.href} class="btn btn-primary hidden lg:inline-flex">
          {cta.label}
        </a>
      )}
    </div>
  </div>
</header>
