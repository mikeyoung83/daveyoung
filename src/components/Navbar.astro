---
// Navbar.astro
// Brand + centered link row + CTA on desktop; brand + right-aligned
// hamburger on mobile, opening a full-screen <dialog> menu (native modal:
// focus trap, Escape to close, background made inert — no library).
// Marks the current page via aria-current rather than decorative
// styling — a quiet, functional signal instead of a visual tell.
// The outer <header> spans full width for its background/border and
// carries the horizontal padding; the inner .navbar is a plain
// mx-auto max-w-6xl with no padding of its own — matching the
// section > mx-auto max-w-6xl div pattern used on every page, so the
// logo/links line up exactly with the page content below.

interface NavItem {
  label: string;
  href: string;
}

interface CTA {
  label: string;
  href: string;
}

interface Props {
  siteName: string;
  navItems: NavItem[];
  cta?: CTA;
}

const { siteName, navItems, cta } = Astro.props;
const currentPath = Astro.url.pathname;
---

<header class="border-b border-base-200 bg-base-100 px-4 lg:px-8">
  <div class="navbar mx-auto max-w-6xl">
    {/* navbar-start is 50% wide by default; on mobile nothing sits in the
        center, so let it grow or the brand wraps onto two lines. */}
    <div class="navbar-start w-auto flex-1 lg:w-1/2 lg:flex-none">
      <a href="/" class="font-heading text-lg font-semibold whitespace-nowrap">
        {siteName}
      </a>
    </div>

    <nav class="navbar-center hidden lg:flex" aria-label="Primary">
      <ul class="menu menu-horizontal gap-1">
        {navItems.map((item) => {
          const isActive = currentPath === item.href;
          return (
            <li>
              <a
                href={item.href}
                aria-current={isActive ? 'page' : undefined}
                class={isActive ? 'bg-transparent font-medium text-primary' : ''}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="navbar-end w-auto lg:w-1/2">
      {cta && (
        <a href={cta.href} class="btn btn-primary hidden lg:inline-flex">
          {cta.label}
        </a>
      )}
      <button
        type="button"
        class="btn btn-ghost btn-square -mr-2 lg:hidden"
        aria-label="Open menu"
        aria-haspopup="dialog"
        aria-controls="mobile-nav"
        data-mobile-nav-open
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  {/* Full-screen mobile menu. Slides down + fades in via @starting-style
      (Tailwind's starting: variant); transition-discrete lets the close
      animate too before display flips back to none. */}
  <dialog
    id="mobile-nav"
    aria-label="Menu"
    class="fixed inset-0 m-0 h-dvh max-h-none w-full max-w-none -translate-y-4 border-0 bg-base-100 p-0 text-base-content opacity-0 transition-all transition-discrete duration-300 ease-out open:translate-y-0 open:opacity-100 starting:open:-translate-y-4 starting:open:opacity-0 motion-reduce:transition-none lg:hidden"
  >
    <div class="flex h-full flex-col">
      <div class="border-b border-base-200 px-4">
        <div class="navbar mx-auto max-w-6xl">
          <div class="flex-1">
            <a href="/" class="font-heading text-lg font-semibold whitespace-nowrap">
              {siteName}
            </a>
          </div>
          <form method="dialog">
            <button class="btn btn-ghost btn-square -mr-2" aria-label="Close menu">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-6 w-6"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6L6 18" />
              </svg>
            </button>
          </form>
        </div>
      </div>

      <nav class="flex flex-1 flex-col overflow-y-auto px-6 py-10" aria-label="Primary">
        <ul class="flex flex-col gap-2">
          {navItems.map((item) => {
            const isActive = currentPath === item.href;
            return (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive ? 'page' : undefined}
                  class={`block py-2 font-heading text-4xl font-semibold ${isActive ? 'text-primary' : 'hover:text-primary'}`}
                >
                  {item.label}
                </a>
              </li>
            );
          })}
        </ul>

        {cta && (
          <a href={cta.href} class="btn btn-primary btn-lg btn-block mt-auto">
            {cta.label}
          </a>
        )}
      </nav>
    </div>
  </dialog>
</header>

<style>
  /* Stop the page behind the open menu from scrolling. */
  :global(html:has(#mobile-nav[open])) {
    overflow: hidden;
  }
</style>

<script>
  const dialog = document.getElementById('mobile-nav') as HTMLDialogElement | null;
  const openButton = document.querySelector<HTMLButtonElement>('[data-mobile-nav-open]');

  openButton?.addEventListener('click', () => dialog?.showModal());

  // The dialog is lg:hidden — if the viewport widens past lg while it's
  // open, close it so an invisible modal doesn't leave the page inert.
  window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
    if (e.matches) dialog?.close();
  });
</script>
