---
// Footer.astro
// Uses daisyUI's `footer` grid (stacked on mobile, columns from `sm` up)
// plus a separate copyright strip below it. Section labels are sentence
// case on purpose — no tracked-out all-caps eyebrow treatment. Like
// Navbar, the outer <footer> spans full width for its background; the
// inner .footer grid is constrained to the same max-w-6xl content width
// used throughout the site. Within each nav group, links run horizontally
// (daisyUI's footer-horizontal only controls the column groups, not the
// links inside one).

interface NavItem {
  label: string;
  href: string;
}

interface SocialLink {
  label: string;
  href: string;
}

interface Props {
  siteName: string;
  navItems: NavItem[];
  tagline?: string;
  address?: string;
  email?: string;
  phone?: string;
  socialLinks?: SocialLink[];
}

const { siteName, navItems, tagline, address, email, phone, socialLinks = [] } = Astro.props;

const year = new Date().getFullYear();
const telHref = (raw: string) => `tel:${raw.replace(/[^+\d]/g, '')}`;
---

<footer class="topo bg-neutral bg-radial-[ellipse_at_top_right] from-primary/20 to-transparent to-70% px-4 py-12 text-neutral-content [--topo-opacity:0.045] lg:px-8">
  <div class="footer mx-auto max-w-6xl sm:footer-horizontal">
    <nav aria-label="Site">
      <h6 class="footer-title">{siteName}</h6>
      {tagline && <p class="max-w-xs text-neutral-content/70">{tagline}</p>}
    </nav>

    <nav aria-label="Footer">
      <h6 class="footer-title">Pages</h6>
      <div class="flex flex-wrap gap-x-6 gap-y-2">
        {navItems.map((item) => (
          <a href={item.href} class="link link-hover">
            {item.label}
          </a>
        ))}
      </div>
    </nav>

    {(address || email || phone) && (
      <nav aria-label="Contact">
        <h6 class="footer-title">Contact</h6>
        <div class="flex flex-wrap gap-x-6 gap-y-2">
          {address && <span class="text-neutral-content/80">{address}</span>}
          {email && (
            <a href={`mailto:${email}`} class="link link-hover">
              {email}
            </a>
          )}
          {phone && (
            <a href={telHref(phone)} class="link link-hover">
              {phone}
            </a>
          )}
        </div>
      </nav>
    )}

    {socialLinks.length > 0 && (
      <nav aria-label="Social">
        <h6 class="footer-title">Follow</h6>
        <div class="flex flex-wrap gap-x-6 gap-y-2">
          {socialLinks.map((link) => (
            <a href={link.href} class="link link-hover">
              {link.label}
            </a>
          ))}
        </div>
      </nav>
    )}
  </div>
</footer>

<div class="border-t border-neutral-content/10 bg-neutral px-4 py-4 lg:px-8">
  <div class="mx-auto max-w-6xl text-sm text-neutral-content/60">
    <p>© {year} {siteName}. All rights reserved.</p>
  </div>
</div>
