---
// Eyebrow.astro
// Small uppercase kicker label above a section heading — the "tight
// tracking, uppercase for eyebrows only" treatment called for in
// STYLE-GUIDE.md's typography section.

interface Props {
  text: string;
  // Color as a prop rather than a passed-in text-* class: two text color
  // utilities on one element resolve by stylesheet order, not markup
  // order, so a `class="text-accent"` override silently lost to the
  // default. Use "accent" on dark backgrounds, where primary lacks contrast.
  tone?: 'primary' | 'accent';
  class?: string;
}

const { text, tone = 'primary', class: className = '' } = Astro.props;
const toneClass = tone === 'accent' ? 'text-accent' : 'text-primary';
---

<p class={`mb-2 text-sm font-semibold tracking-widest uppercase ${toneClass} ${className}`}>
  {text}
</p>
