---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Eyebrow from '../components/Eyebrow.astro';
import { siteConfig } from '../site-config';
import { getFeaturedProjects } from '../lib/projects';
import heroSource from '../assets/hero/backyard-deck.jpg';

const featuredProjects = await getFeaturedProjects();
const { serviceTowns } = siteConfig;

// Background photo: real deck build, sourced from Unsplash (free for
// commercial use) as a stand-in until Dave supplies his own project
// photography — see CLAUDE.md's status section.
---

<BaseLayout
  {...siteConfig}
  title="Bruce Peninsula Renovations & Decks"
  description="Kitchen and bath renovations, additions and decks from Owen Sound to Tobermory. I'm on site for every job. Licensed, insured, and quotes are free."
>
  <div class="hero relative isolate min-h-[85vh]">
    {/* A real <picture> rather than a CSS background-image: the preload
        scanner finds it immediately, and phones get a small WebP
        instead of the 2400px original. It's the LCP element, so load it
        eagerly at high priority. The 70% overlay hides compression, so
        quality can sit lower than for an unobscured photo. */}
    <Picture
      src={heroSource}
      alt=""
      formats={['webp']}
      widths={[640, 960, 1280, 1920, 2400]}
      sizes="100vw"
      quality={65}
      loading="eager"
      fetchpriority="high"
      pictureAttributes={{ class: 'absolute inset-0 -z-10' }}
      class="h-full w-full object-cover"
    />
    {/* Darkest behind the left-aligned text, easing off to the right so
        more of the photo shows. Flat on mobile, where text spans the width. */}
    <div
      class="hero-overlay bg-neutral/75 sm:bg-transparent sm:bg-linear-to-r sm:from-neutral/90 sm:via-neutral/70 sm:to-neutral/35"
    ></div>
    <div class="hero-content w-full max-w-6xl flex-col items-start px-4 py-24 text-left lg:px-8">
      <Eyebrow text="Bruce Peninsula & Owen Sound · Since 2016" tone="accent" />
      <h1
        class="max-w-3xl text-balance font-heading text-5xl leading-none font-bold text-neutral-content sm:text-7xl lg:text-8xl"
      >
        Built right, the first time.
      </h1>
      <p class="mt-6 max-w-xl text-lg text-neutral-content/90 sm:text-xl">
        Kitchens, bathrooms, additions and decks, and I'm on site for every one. Licensed and
        insured since 2016.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/contact" class="btn btn-primary btn-lg">Get a Free Quote</a>
        <a
          href="/projects"
          class="btn btn-outline btn-lg border-neutral-content/60 text-neutral-content hover:bg-neutral-content hover:text-neutral"
        >
          See My Work
        </a>
      </div>
    </div>
  </div>

  <section class="topo bg-base-200 bg-radial-[ellipse_at_top] from-primary/8 to-transparent to-70% px-4 py-16 sm:py-24 lg:px-8">
    <div class="mx-auto max-w-4xl text-center">
      <Eyebrow text="Why homeowners call me" class="text-center" />
      <h2 class="font-heading text-4xl leading-tight font-bold sm:text-5xl">
        One builder, start to finish.
      </h2>
      <p class="mt-4 text-lg text-base-content/70">
        When you hire me, you get me. I quote the job, I'm on site while it's built, and I'm the
        one you call with questions. No hand-offs, and no wondering who's showing up.
      </p>
    </div>

    <div class="mx-auto mt-12 grid max-w-6xl gap-6 sm:grid-cols-3">
      <div class="card card-border bg-base-100 shadow-soft">
        <div class="card-body items-start gap-3 p-8">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-14 w-14 rounded-field bg-linear-to-br from-accent/25 to-primary/10 p-3 text-primary"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
          >
            <circle cx="12" cy="8" r="4" />
            <path stroke-linecap="round" d="M4 21a8 8 0 0 1 16 0" />
          </svg>
          <h3 class="font-heading text-2xl font-semibold">On site for every job</h3>
          <p class="text-base-content/70">
            The person you hire is the person doing the work, from the first measurement to the final walk-through.
          </p>
        </div>
      </div>

      <div class="card card-border bg-base-100 shadow-soft">
        <div class="card-body items-start gap-3 p-8">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-14 w-14 rounded-field bg-linear-to-br from-accent/25 to-primary/10 p-3 text-primary"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
          >
            <rect x="8" y="2" width="8" height="4" rx="1" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2M9 12h6M9 16h4" />
          </svg>
          <h3 class="font-heading text-2xl font-semibold">Free quotes</h3>
          <p class="text-base-content/70">
            I'll look at the space, talk through what you want, and give you a clear quote at no cost.
          </p>
        </div>
      </div>

      <div class="card card-border bg-base-100 shadow-soft">
        <div class="card-body items-start gap-3 p-8">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-14 w-14 rounded-field bg-linear-to-br from-accent/25 to-primary/10 p-3 text-primary"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 3 4 6v6c0 5 3.5 8.5 8 9 4.5-.5 8-4 8-9V6l-8-3Z"
            />
            <path stroke-linecap="round" stroke-linejoin="round" d="m9 12 2 2 4-4" />
          </svg>
          <h3 class="font-heading text-2xl font-semibold">Licensed & insured</h3>
          <p class="text-base-content/70">
            Every job is fully covered, start to finish, as it has been since 2016.
          </p>
        </div>
      </div>
    </div>

    <div class="mt-12 text-center">
      <a href="/services" class="btn btn-neutral tracking-wide uppercase">See What I Build</a>
    </div>
  </section>

  {featuredProjects.length > 0 && (
    <section class="px-4 py-16 sm:py-24 lg:px-8">
      <div class="mx-auto max-w-6xl">
        <div class="flex items-end justify-between gap-4">
          <div>
            <Eyebrow text="Recent work" />
            <h2 class="font-heading text-3xl font-semibold sm:text-4xl">
              Proof, not promises
            </h2>
          </div>
          <a href="/projects" class="link link-hover font-medium text-primary">View all projects</a>
        </div>

        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {featuredProjects.map((project) => (
            <ProjectCard
              slug={project.slug}
              title={project.title}
              category={project.category}
              description={project.description}
              location={project.location}
              image={project.photos[0].src}
              imageAlt={project.photos[0].alt}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="border-y border-base-300 bg-base-200 px-4 py-16 sm:py-24 lg:px-8">
    <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-2 lg:items-center">
      <div>
        <Eyebrow text="Where I work" />
        <h2 class="font-heading text-3xl leading-tight font-semibold sm:text-4xl">
          Homes and cottages across Grey-Bruce
        </h2>
        <p class="mt-4 max-w-prose text-lg text-base-content/80">
          I'm based in Wiarton and work from Owen Sound up to Tobermory. Cottage projects are some
          of my favourite work. If you're not up here full-time, I'll keep you updated while the
          job gets done.
        </p>
      </div>

      <ul class="flex flex-wrap gap-3" aria-label="Towns I work in">
        {serviceTowns.map((town) => (
          <li class="flex items-center gap-2 rounded-field border border-base-300 bg-base-100 px-4 py-2 font-heading text-lg font-semibold shadow-soft">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4 text-primary"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M21 10c0 6.5-9 12-9 12s-9-5.5-9-12a9 9 0 0 1 18 0Z"
              />
              <circle cx="12" cy="10" r="3" />
            </svg>
            {town}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="topo bg-neutral bg-radial-[ellipse_at_top_right] from-primary/30 to-transparent to-70% px-4 py-16 text-neutral-content [--topo-opacity:0.05] sm:py-24 lg:px-8">
    <div class="mx-auto flex max-w-4xl flex-col items-start gap-6">
      <Eyebrow text="Free quotes" tone="accent" />
      <h2 class="font-heading text-3xl font-semibold sm:text-4xl">
        Planning a project? Let's talk.
      </h2>
      <p class="max-w-prose text-lg text-neutral-content/80">
        Tell me what you have in mind and I'll get back to you personally. Quotes are always free.
      </p>
      <a href="/contact" class="btn btn-primary">Get a Free Quote</a>
    </div>
  </section>
</BaseLayout>
