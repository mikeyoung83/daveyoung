---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import FooterCta from '../../components/FooterCta.astro';
import { siteConfig } from '../../site-config';
import { projectCategories } from '../../content.config';
import { getProjects } from '../../lib/projects';

const projects = await getProjects();
---

<BaseLayout
  {...siteConfig}
  title="Recent Renovation Projects"
  description="Photos of finished renovations, additions and decks from around the Bruce Peninsula and Owen Sound. Filter by type of work, or browse them all."
>
  <section class="bg-radial-[ellipse_at_top] from-primary/8 to-transparent to-70% px-4 py-16 sm:py-24 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="max-w-2xl">
        <Eyebrow text="Projects" />
        <h1 class="font-heading text-4xl font-semibold leading-tight sm:text-5xl">
          See the work
        </h1>
        <p class="mt-4 max-w-prose text-lg text-base-content/70">
          Finished renovations, additions and decks from around the Bruce Peninsula and Owen
          Sound. Filter by type of work, or browse them all.
        </p>
      </div>

      {projects.length > 0 ? (
        <>
          <form class="filter mt-8">
            <input class="btn btn-square" type="reset" value="×" />
            {projectCategories.map((category) => (
              <input
                class="btn"
                type="radio"
                name="project-category"
                aria-label={category}
                data-category={category}
              />
            ))}
          </form>

          <div id="project-grid" class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {projects.map((project) => (
              <div data-category={project.category}>
                <ProjectCard
                  slug={project.slug}
                  title={project.title}
                  category={project.category}
                  description={project.description}
                  location={project.location}
                  image={project.photos[0].src}
                  imageAlt={project.photos[0].alt}
                />
              </div>
            ))}
          </div>

          <p id="project-empty" class="mt-8 text-base-content/70" hidden>
            No projects of this type yet. Check back soon, or
            <button type="button" class="link link-primary" data-clear-filter>see all projects</button>.
          </p>
        </>
      ) : (
        <p class="mt-8 text-lg text-base-content/70">
          Project photos are on their way. Check back soon, or
          <a href="/contact" class="link link-primary">get in touch</a> to talk about yours.
        </p>
      )}
    </div>
  </section>

  <FooterCta />

  <script>
    const form = document.querySelector<HTMLFormElement>('.filter');
    const cards = document.querySelectorAll<HTMLElement>('#project-grid [data-category]');

    const empty = document.getElementById('project-empty');

    const applyFilter = (category: string | undefined) => {
      let visible = 0;
      cards.forEach((card) => {
        card.hidden = Boolean(category) && card.dataset.category !== category;
        if (!card.hidden) visible += 1;
      });
      if (empty) empty.hidden = visible > 0;
    };

    document.querySelector('[data-clear-filter]')?.addEventListener('click', () => form?.reset());

    form?.addEventListener('change', () => {
      const selected = form.querySelector<HTMLInputElement>('input[type="radio"]:checked');
      applyFilter(selected?.dataset.category);
    });

    form?.addEventListener('reset', () => {
      // Reset fires before radios actually clear, so wait a tick.
      requestAnimationFrame(() => applyFilter(undefined));
    });
  </script>
</BaseLayout>
