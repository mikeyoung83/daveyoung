---
// services.astro
// Photo-led card grid + two-column approach section + testimonial block,
// adapted from inspiration/services-1.jpg and services-2.jpg. The
// testimonial keeps services-1.jpg's layout (stars, quote, attribution,
// photo) but with an obvious bracketed placeholder instead of its quote —
// we don't have a real client testimonial yet, and inventing a
// realistic-sounding one with a fake name would be fabricated content,
// not a design borrow.
import type { ImageMetadata } from 'astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Eyebrow from '../components/Eyebrow.astro';
import FooterCta from '../components/FooterCta.astro';
import { siteConfig } from '../site-config';
import remodelImage from '../assets/services/remodel-kitchen.jpg';
import additionImage from '../assets/services/addition-framing.jpg';
import deckImage from '../assets/services/deck-exterior.jpg';
import testimonialImage from '../assets/services/bathroom-remodel.jpg';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);

const IMAGE_BY_TITLE: Record<string, ImageMetadata> = {
  'Remodels & Renovations': remodelImage,
  'Additions & Structural': additionImage,
  'Decks, Outdoor & Exteriors': deckImage,
};
---

<BaseLayout
  {...siteConfig}
  title="Renovations, Additions & Decks"
  description="Kitchen and bathroom renovations, whole-home remodels, additions, decks and exterior work across the Bruce Peninsula and Owen Sound. Free quotes."
>
  <section class="bg-radial-[ellipse_at_top] from-primary/8 to-transparent to-70% px-4 py-16 sm:py-24 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <Eyebrow text="Services" class="text-center" />
      <h1 class="font-heading text-4xl leading-tight font-bold sm:text-5xl">
        What I build
      </h1>
      <p class="mt-4 text-lg text-base-content/70">
        Big or small, every job gets the same care: a free quote, a clear plan, and me on site
        until the work is done.
      </p>
    </div>

    <div class="mx-auto mt-12 grid max-w-6xl gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((service) => (
        <ServiceCard
          title={service.data.title}
          summary={service.data.summary}
          image={IMAGE_BY_TITLE[service.data.title]}
        />
      ))}
    </div>

    <div class="mt-12 text-center">
      <a href="/contact" class="btn btn-primary">Get a Free Quote</a>
    </div>
  </section>

  <section class="topo border-t border-base-300 bg-base-200 px-4 py-16 sm:py-24 lg:px-8">
    <div class="mx-auto grid max-w-6xl gap-8 lg:grid-cols-2">
      <div>
        <Eyebrow text="My approach" />
        <h2 class="font-heading text-3xl leading-tight font-semibold sm:text-4xl">
          Straightforward, start to finish.
        </h2>
      </div>
      <div class="space-y-4 text-lg text-base-content/80">
        <p>
          Every job starts with a free quote and a clear plan, so you know what's being built and
          what it costs before any work begins. After that, I'm on site for the build. You won't be
          handed off to someone you've never met.
        </p>
        <p>
          Own a cottage up here? Cottage projects are some of my favourite work. If you're not
          around full-time, I'll keep you updated while the job gets done.
        </p>
      </div>
    </div>
  </section>

  <section class="px-4 py-16 sm:py-24 lg:px-8">
    <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-2 lg:items-center">
      <div>
        <div class="flex gap-1 text-accent">
          {Array.from({ length: 5 }).map(() => (
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2.5 15 9l7 .7-5.3 4.6L18.2 21 12 17.3 5.8 21l1.5-6.7L2 9.7 9 9Z" />
            </svg>
          ))}
        </div>

        <blockquote class="mt-4 font-heading text-2xl leading-snug font-semibold text-base-content/60 italic sm:text-3xl">
          <!-- TODO: replace with a real client testimonial once available. -->
          "[A short quote from a real client about working with Dave. Ask a happy customer if
          they'd be willing to share a sentence or two.]"
        </blockquote>

        <p class="mt-4 font-medium text-base-content/60">[Client Name]</p>
        <p class="text-sm text-base-content/50">[Project — Town, ON]</p>
      </div>

      <div class="aspect-4/3 overflow-hidden rounded-box shadow-lift-lg" data-reveal>
        <Image
          src={testimonialImage}
          alt="A finished bathroom remodel"
          widths={[480, 800, 1120]}
          sizes="(min-width: 1024px) 560px, calc(100vw - 2rem)"
          class="h-full w-full object-cover"
        />
      </div>
    </div>
  </section>

  <FooterCta />
</BaseLayout>
