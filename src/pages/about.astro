---
// about.astro
// Layout inspired by inspiration/about.png (asymmetric intro, bare stat
// numbers, captioned project strip, stacked process rows) — adapted to
// our actual facts rather than the inspiration's numbers, which aren't
// ours to reuse. See STYLE-GUIDE.md section 7.
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import FooterCta from '../components/FooterCta.astro';
import { siteConfig } from '../site-config';
import { getFeaturedProjects } from '../lib/projects';
import deckPhoto from '../assets/about/deck-cottage.jpg';

const featuredProjects = await getFeaturedProjects();

// How a job runs, in order. One-off page copy, so it lives here rather
// than in a collection.
const steps = [
  {
    title: 'A free quote',
    body: "I'll come out, look at the space and talk through what you want. Then you get a clear quote, at no cost.",
  },
  {
    title: 'A plan you understand',
    body: "Before any work starts, we'll agree on what's being built and what it costs, in plain language.",
  },
  {
    title: 'Me, on site',
    body: "I'm there for the work, so you always know who's on the job and who to call.",
  },
  {
    title: 'Built right, the first time',
    body: "Whether it's a full addition or a single deck rebuild, every job gets the same care.",
  },
];
---

<BaseLayout
  {...siteConfig}
  title="About Dave, Builder Since 2016"
  description="I'm Dave Young, a Wiarton-based builder renovating homes and cottages across the Bruce Peninsula and Owen Sound since 2016. On site for every job."
>
  <section class="bg-radial-[ellipse_at_top] from-primary/8 to-transparent to-70% px-4 py-16 sm:py-24 lg:px-8">
    <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-2 lg:items-center">
      <div>
        <Eyebrow text="About" />
        <h1 class="font-heading text-4xl leading-tight font-bold sm:text-5xl">
          Hi, I'm Dave.
        </h1>

        <div class="mt-6 max-w-prose space-y-4 text-lg text-base-content/80">
          <p>
            I've been renovating homes and cottages on the Bruce Peninsula since 2016. I'm based in
            Wiarton, and I'm on site for every job I take on, from kitchens and bathrooms to
            additions and decks.
          </p>
          <p>
            <!-- TODO: replace with Dave's own words once supplied. -->
            [A few sentences in your own words: how you got into building, what you enjoy about
            the work, and why you started your own business.]
          </p>
        </div>

        <div class="mt-8">
          <a href="/contact" class="btn btn-primary">Get a Free Quote</a>
        </div>
      </div>

      <div class="aspect-4/3 overflow-hidden rounded-box shadow-lift-lg" data-reveal>
        <Image
          src={deckPhoto}
          alt="A finished wood deck on a home on the Bruce Peninsula"
          widths={[480, 800, 1120]}
          sizes="(min-width: 1024px) 560px, calc(100vw - 2rem)"
          class="h-full w-full object-cover"
        />
      </div>
    </div>
  </section>

  <section class="topo border-y border-base-300 bg-base-200 px-4 py-14 lg:px-8">
    <div class="mx-auto grid max-w-6xl gap-8 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <div class="font-heading text-5xl font-bold text-primary">10</div>
        <p class="mt-1 text-base-content/70">Years on the Peninsula</p>
      </div>
      <div>
        <div class="font-heading text-5xl font-bold text-primary">3</div>
        <p class="mt-1 text-base-content/70">Specialties: renovations, additions and decks</p>
      </div>
      <div>
        <div class="font-heading text-2xl font-bold text-primary">Based in Wiarton</div>
        <p class="mt-1 text-base-content/70">Working from Owen Sound to Tobermory</p>
      </div>
      <div>
        <div class="font-heading text-2xl font-bold text-primary">Licensed & Insured</div>
        <p class="mt-1 text-base-content/70">Every job covered, start to finish</p>
      </div>
    </div>
  </section>

  {featuredProjects.length > 0 && (
    <section class="px-4 py-16 sm:py-24 lg:px-8">
      <div class="mx-auto max-w-6xl">
        <Eyebrow text="Recent work" />
        <h2 class="font-heading text-3xl font-semibold sm:text-4xl">Some recent jobs</h2>

        <div class="mt-8 grid gap-6 sm:grid-cols-3">
          {featuredProjects.map((project) => (
            <a href={`/projects/${project.slug}`} class="group block" data-reveal>
              <div class="aspect-4/3 overflow-hidden rounded-box shadow-soft transition-shadow duration-300 group-hover:shadow-lift">
                <Image
                  src={project.photos[0].src}
                  alt={project.photos[0].alt}
                  widths={[400, 700, 1000]}
                  sizes="(min-width: 1024px) 370px, (min-width: 640px) 30vw, calc(100vw - 2rem)"
                  class="h-full w-full object-cover transition-transform duration-500 motion-safe:group-hover:scale-105"
                />
              </div>
              <p class="mt-3 font-heading text-lg font-semibold">{project.title}</p>
              <p class="text-sm text-base-content/60">{project.category}</p>
            </a>
          ))}
        </div>

        <div class="mt-8">
          <a href="/projects" class="link link-hover font-medium text-primary">
            View all projects
          </a>
        </div>
      </div>
    </section>
  )}

  <section class="bg-base-200 px-4 py-16 sm:py-24 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <Eyebrow text="How I work" />
      <h2 class="font-heading text-3xl font-semibold sm:text-4xl">What you can expect</h2>

      <ol class="mt-8 divide-y divide-base-300 border-y border-base-300">
        {steps.map((step, i) => (
          <li class="grid gap-2 py-6 sm:grid-cols-[1fr_2fr] sm:gap-8">
            <h3 class="flex items-baseline gap-3 font-heading text-xl font-semibold">
              <span class="text-primary" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              {step.title}
            </h3>
            <p class="text-base-content/70">{step.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <FooterCta />
</BaseLayout>
